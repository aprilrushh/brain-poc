[Unit]
Description=Brain — FastAPI uvicorn server (production, port 8000)
Documentation=https://github.com/aprilrushh/brain-poc
After=network-online.target
Wants=network-online.target
Before=brain-tunnel.service
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/brain-poc
EnvironmentFile=/home/ubuntu/brain-poc/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/brain-poc/.venv/bin/uvicorn app.server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
