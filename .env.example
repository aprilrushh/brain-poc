# ============================================================
# Brain Project — Environment Variables
# Copy to .env and fill in actual values. Do NOT commit .env.
# ============================================================

# --- LLM Provider ---
# Mode: api (Together / OpenRouter) or local (vLLM, B200 only)
LLM_MODE=api

# Together AI (default)
LLM_API_BASE=https://api.together.xyz/v1
LLM_API_KEY=your_together_api_key_here
LLM_MODEL=Qwen/Qwen3.5-397B-A17B

# Together / OpenRouter API keys (for LLM_API_KEY swap)
TOGETHER_API_KEY=your_together_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Brain ---
BRAIN_BETA=50.0
BRAIN_TOP_K=5

# --- Paths ---
DATA_DIR=./data
LOG_DIR=./logs

# --- Thinking ---
# Default thinking strategy: auto (hybrid), always_on, always_off
THINKING_MODE=auto
